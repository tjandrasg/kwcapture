include README.md
include LICENSE
include CHANGELOG.md
include AGENTS.md
# The trust documents go in the sdist too: the people who run `pip install --no-binary`
# are exactly the people who read them, and an auditor inspecting the tarball should see
# the same SECURITY.md the repo advertises. Docs are included by explicit name here, so a
# new root .md is invisible to packaging until it is added to this list.
include SECURITY.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include pyproject.toml
include setup.py
include kwcapture/native/*.c
include kwcapture/native/include/*.h
include kwcapture/py.typed
# The brand icons ship inside the package (artwork under CC BY 4.0, with COPYING.md next to
# them saying so). The `logo/` directory that generates them is deliberately NOT in the
# sdist — 1.5 MB on this checkout, 1.1 MB of it generated review PNGs (measured with
# `du -sb logo --exclude='*.jsonl'`, not guessed) — but `--check` in the repo is what keeps this
# copy honest, so a packager can always verify the shipped bytes against the real artwork.
recursive-include kwcapture/icons *
recursive-include tests *.py
include bench.py
include .github/workflows/*.yml

prune kwcapture/bin
prune probe
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude kwcapture/bin/kwcapture
global-exclude .DS_Store
prune **/__pycache__
prune .venv
exclude prompt.txt
exclude bench_result.md
