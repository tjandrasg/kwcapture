include README.md
include LICENSE
include CHANGELOG.md
include AGENTS.md
include pyproject.toml
include setup.py
include kwcapture/native/*.c
include kwcapture/native/include/*.h
include kwcapture/py.typed
recursive-include tests *.py
include bench.py
include .github/workflows/*.yml

prune kwcapture/bin
prune probe
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude kwcapture/bin/kwcapture
global-exclude .DS_Store
prune **/__pycache__
prune .venv
exclude prompt.txt
exclude bench_result.md
